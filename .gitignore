# .gitignore para dotfiles dentro de ~/.config
# Atualizado: ignora grandes pastas de apps, caches e segredos; mantém configs portáteis

# Diretórios de dados de aplicativos (não versionar)
# Regra geral: qualquer diretório que não seja configKnown fica fora.
# exceção é o inverso — listar explicitamente o que é configKnown.
/*/

# Pastas de apps conhecidas que NÃO são config (o /*/ acima já cobre;
# estas ficam explícitas por causa de nomes com espaço)
/Android Open Source Project/
/Cemu/
/Claude/
/Cursor/
/GitHub Desktop/
/Grok Bot/
/JetBrains/
/KDE/
/LM Studio/
/LM-Studio/
/PCSX2/
/UNDERTALE/
/Unity/
/codegenv/
/codium/
/obs-studio/
/sst/
/yarn/
/google-chrome/
/google-chrome-for-testing/
/google-chrome-headless/

