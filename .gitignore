# Caches e artefatos de tooling
graphify-out/
**/graphify-out/
waybar-view.png
.playwright-mcp/
.token-optimizer/
/.opencode/
**/.cache/

# Caches, builds e dependências
**/cache/
**/Cache/
**/CachedData/
**/GPUCache/
**/BrowserSupport/
node_modules/
__pycache__/
*.pyc
.cache/
*.log
npm-debug.log
yarn-error.log
tmp/
temp/

# Lockfiles: só os que fazem sentido versionar em dotfiles.
# O blanket *.lock anterior escondeia o lazy-lock.json do nvim.
*.lock
!/nvim/lazy-lock.json

# Segredos / chaves / credenciais (não commitar)
**/.ssh/id_*
**/.ssh/ssh_host_*
**/.gnupg/

# Configs com dados de projetos internos (não commitar; schema em projects.example.json)
opencode/skills/pr-review/projects.json
**/.gpg/
**/.password-store/
.env
.env.*
*.pem
*.key
*.bak
credentials
**/.aws/
**/azure/
**/gcloud/

# Arquivos binários e bancos de dados
*.sqlite
*.db
*.sqlite3
*.bin
*.exe
*.dll

# Arquivos específicos do sistema / desktop
.DS_Store
Thumbs.db
.plasma-org.kde.plasma.desktop-appletsrc.cache

# Ignorar caches de browsers e extensões
**/chrome-extension-data/

# Exceções: configs portáveis que valem versionar.
# A regra /*/ acima nega todo diretório de primeiro nível, então cada
# exceção precisa ser explícita.
!nvim/
!hypr/
!waybar/
!wofi/
!kitty/
!fish/
!mpv/
!obs-studio/
!qBittorrent/
!pulse/
!systemd/
!gh/
!git/
!rtk/
!zed/
!spotify/
!mako/
!pupgui/
!MangoHud/
!MangoHud/
!cava/
!bashtop/
!htop/
!rclone/
!rustdesk/
!glow/
!uv/
!mise/
!misc/
!autostart/
!docs/
!dconf/
!opencode/
!assets/
!mimeapps.list
!user-dirs.dirs.locale
!README.md
!AGENTS.md
!.gitignore

# Não versionar
waybar-view.png

# Observação: revise antes de commitar arquivos listados nas negações — alguns podem conter caminhos absolutos ou dados específicos da máquina
