{
  "height": 26,
  "spacing": 5,
  "layer": "top",
  "position": "top",

  "modules-left": [
    "hyprland/workspaces"
  ],
  "modules-center": ["hyprland/window"],
  "modules-right": [
    "tray",
    "network",
    "pulseaudio",
    "backlight",
    "battery",
    "custom/tlp",
    "custom/bt",
    "custom/notif",
    "custom/sysinfo",
    "custom/nightlight",
    "clock",
  ],
  "clock": {
    "on-click": "~/.config/quickshell/popup/open.sh calendar",
    "timezone": "America/Sao_Paulo",
    "format": "{:%H:%M - %d/%m/%Y}",
    "tooltip-format": "<tt>{calendar}</tt>",
    "calendar": {
      "format": {
        "months": "<span color='#ffead3'><b>{}</b></span>",
        "today": "<span color='#ff6699'><b>{}</b></span>",
      },
    },
  },
  "battery": {
    "bat": "BAT1",
    "interval": 60,
    "states": {
      "warning": 30,
      "critical": 15,
    },
    "format": "{icon}   {capacity}%",
    "format-icons": [
      "",
      "",
      "",
      "",
      ""
    ],
    "max-length": 25,
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": " ",
    "format-icons": {
      "headphone": " ",
      "hands-free": " ",
      "headset": " ",
      "phone": " ",
      "portable": " ",
      "car": " ",
      "default": [
        " ",
        " ",
        "  "
      ],
    },
    "on-click": "~/.config/quickshell/popup/open.sh volume",
    "on-click-right": "pavucontrol",
  },
  // Perfil de energia. O clique CICLAVA os perfis, e isso e pior do que
  // parece: com tres posicoes e um ciclo, metade dos cliques vai para
  // "performance" sem a pessoa pedir -- e "performance" gasta bateria.
  // Agora o clique abre o painel, onde os tres perfis sao nomeados e a
  // troca e explicita. O display continua mostrando onde voce esta.
  "custom/tlp": {
    "exec": "/home/monteiro/.config/waybar/scripts/tlp.sh status",
    "signal": 2,
    "return-type": "json",
    "format": "{}",
    "on-click": "~/.config/quickshell/popup/open.sh battery",
    "tooltip": true
  },

  // Bluetooth. Antes nao havia nada de bluetooth na barra, so um icone
  // que eu nao sabia de onde vinha. Este mostra quantos aparelhos estao
  // conectados e abre o painel do quickshell.
  "custom/bt": {
    "exec": "~/.config/waybar/scripts/bt.sh",
    "interval": 5,
    "return-type": "json",
    "on-click": "~/.config/quickshell/popup/open.sh bluetooth",
    "tooltip": false
  },

  // Contador de notificacoes nao lidas.
  //
  // O historico mora no processo do quickshell, entao este script nao le
  // nada: ele so informa se ha alguma. Um numero exato exigiria IPC de
  // volta do quickshell, que ainda nao existe.
  "custom/notif": {
    "exec": "~/.config/waybar/scripts/notif-count.sh",
    "return-type": "json",
    "on-click": "~/.config/quickshell/popup/open.sh notification",
    "tooltip": true
  },

  // Um icone no lugar de cpu + memory + temperature. Cinza em repouso,
  // amarelo quando algo passa do aceitavel, vermelho no critico -- o
  // numero fica no tooltip e no popup, que abrem no clique.
  // Mesmos cortes do StatBar.qml, para barra e popup concordarem.
  "custom/sysinfo": {
    "exec": "~/.config/waybar/scripts/sysinfo.sh",
    // return-type json e obrigatorio: sem ele o waybar trata a linha como
    // texto puro e a barra mostra o JSON cru.
    "return-type": "json",
    // Sem reinicio periodico: o script ja e um laco que imprime uma
    // linha por ciclo. Configurar um intervalo aqui faz o waybar matar e
    // reiniciar o script, e o icone pisca. Nao escrever o nome da opcao
    // neste comentario: o teste varre o bloco procurando ele e se
    // auto-alerta.
    "on-click": "~/.config/quickshell/popup/open.sh resources",
    "tooltip": true
  },
 "network": {
    "format-wifi": "   {essid}",
    "format-ethernet": "󰈀   {ifname}",
    "format-linked": "󰈀   {ifname} (No IP)",
    "format-disconnected": "⚠   Disconnected",
    "tooltip-format-wifi": "{essid}  ({signaldBm}dBm) ",
    // "~/" e absolute divergem do resto do arquivo de proposito: o waybar roda
// o on-click via sh -c, que expande ~, e o caminho sobrevive a mudar de
// usuario ou de maquina -- que e o objetivo de replicar estes dotfiles.
"on-click": "~/.config/waybar/scripts/wifi-menu.sh",
    "on-click-right": "pavucontrol"
  },
  "hyprland/workspaces": {
    "sort-by": "number",
    "show-special": true,
    // Hyprland 0.55+ trocou os dispatchers legados ("workspace 2") por
    // expressoes Lua. hyprctl dispatch envolve o argumento em hl.dispatch(),
    // entao passamos o dispatcher, nao o nome dele.
    "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({workspace=\"e-1\"})'",
    "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({workspace=\"e+1\"})'"
  },
  "hyprland/window": {
    "format": "{title}",
    "icon": true,
    "icon-size": 16
  },
  "backlight": {
    // Sem "device": esta maquina e AMD e o unico backlight e amdgpu_bl1.
    // Apontar para "intel_backlight" nao dava erro -- o modulo caia no
    // auto-detect e mostrava os percentuais certos, mascarando o problema.
    "format": "{icon} {percent}%",
    "format-icons": ["", "", "", "", "", "", "", "", ""],
    "on-scroll-up": "/home/monteiro/.config/hypr/scripts/brightness.sh up 1 quiet",
    "on-scroll-down": "/home/monteiro/.config/hypr/scripts/brightness.sh down 1 quiet",
    "on-click": "~/.config/quickshell/popup/open.sh brightness"
  },
  "custom/nightlight": {
    "exec": "/home/monteiro/.config/waybar/scripts/nightlight.sh status",
    "signal": 3,
    "return-type": "json",
    "format": "{}",
    "on-click": "/home/monteiro/.config/waybar/scripts/nightlight.sh toggle",
    "tooltip": true
  }
}
