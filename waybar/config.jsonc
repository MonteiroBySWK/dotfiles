{
  "height": 15,
  "spacing": 5,
  "layer": "top",
  "position": "top",

  "modules-left": [
    "hyprland/workspaces"
  ],
  "modules-center": ["hyprland/window"],
  "modules-right": [
    "tray",
    "network",
    "pulseaudio",
    "backlight",
    "battery",
    "custom/tlp",
    "temperature",
    "cpu",
    "memory",
    "custom/nightlight",
    "clock",
  ],
  "clock": {
    "timezone": "America/Sao_Paulo",
    "format": "{:%H:%M - %d/%m/%Y}",
    "tooltip-format": "<tt>{calendar}</tt>",
    "calendar": {
      "format": {
        "months": "<span color='#ffead3'><b>{}</b></span>",
        "today": "<span color='#ff6699'><b>{}</b></span>",
      },
    },
  },
  "battery": {
    "bat": "BAT1",
    "interval": 60,
    "states": {
      "warning": 30,
      "critical": 15,
    },
    "format": "{icon}   {capacity}%",
    "format-icons": [
      "",
      "",
      "",
      "",
      ""
    ],
    "max-length": 25,
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": " ",
    "format-icons": {
      "headphone": " ",
      "hands-free": " ",
      "headset": " ",
      "phone": " ",
      "portable": " ",
      "car": " ",
      "default": [
        " ",
        " ",
        "  "
      ],
    },
    "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
    "on-click-right": "pavucontrol",
  },
  "custom/tlp": {
    "exec": "/home/monteiro/.config/waybar/scripts/tlp.sh status",
    "signal": 2,
    "return-type": "json",
    "format": "{}",
    "on-click": "/home/monteiro/.config/waybar/scripts/tlp.sh toggle",
    "tooltip": true
  },
  "custom/notifications": {
    "tooltip": false,
    "format": "{icon}",
    "format-icons": {
        "notification": "<span color='red'><sup></sup></span>",
        "none": "",
        "dnd": ""
    },
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true
  },
  "cpu": {
    "format": "  {usage}%",
    "tooltip": false
  },
  "temperature": {
    "critical-threshold": 80,
    "format": "{icon} {temperatureC}°C",
    "format-icons": ["", "", ""]
  },
  "memory": {
    "format": " {}%"
  },
 "network": {
    "format-wifi": "   {essid}",
    "format-ethernet": "󰈀   {ifname}",
    "format-linked": "󰈀   {ifname} (No IP)",
    "format-disconnected": "⚠   Disconnected",
    "tooltip-format-wifi": "{essid}  ({signaldBm}dBm) ",
    // "~/" e absolute divergem do resto do arquivo de proposito: o waybar roda
// o on-click via sh -c, que expande ~, e o caminho sobrevive a mudar de
// usuario ou de maquina -- que e o objetivo de replicar estes dotfiles.
"on-click": "~/.config/waybar/scripts/wifi-menu.sh",
    "on-click-right": "pavucontrol"
  },
  "hyprland/workspaces": {
    "sort-by": "number",
    "show-special": true,
    // Hyprland 0.55+ trocou os dispatchers legados ("workspace 2") por
    // expressoes Lua. hyprctl dispatch envolve o argumento em hl.dispatch(),
    // entao passamos o dispatcher, nao o nome dele.
    "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({workspace=\"e-1\"})'",
    "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({workspace=\"e+1\"})'"
  },
  "hyprland/window": {
    "format": "{title}",
    "icon": true,
    "icon-size": 16
  },
  "backlight": {
    "device": "intel_backlight", // ou "amdgpu_bl0", mas geralmente funciona sem essa linha
    "format": "{icon} {percent}%",
    "format-icons": ["", "", "", "", "", "", "", "", ""],
    "on-scroll-up": "/home/monteiro/.config/hypr/scripts/brightness.sh up 1 quiet",
    "on-scroll-down": "/home/monteiro/.config/hypr/scripts/brightness.sh down 1 quiet"
  },
  "custom/nightlight": {
    "exec": "/home/monteiro/.config/waybar/scripts/nightlight.sh status",
    "signal": 3,
    "return-type": "json",
    "format": "{}",
    "on-click": "/home/monteiro/.config/waybar/scripts/nightlight.sh toggle",
    "tooltip": true
  }
}
