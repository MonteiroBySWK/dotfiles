{
  // opencode-mem — memória com retrieval semântico (embeddings locais, sem API paga)
  "autoCaptureEnabled": true,
  "opencodeProvider": "opencode-go",
  "opencodeModel": "opencode-go/mimo-v2.5",
  "embeddingModel": "Xenova/nomic-embed-text-v1",
  "memory": {
    "defaultScope": "project"
  },
  "webServerEnabled": true,
  "webServerPort": 4747
}
